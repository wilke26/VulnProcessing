########################################
# Management API
########################################
# Ohne konfigurierte Credentials antworten Management-Routen fail-closed mit 503.
# Format und verfügbare Operations-Scopes: siehe README.md.
MANAGEMENT_CREDENTIALS=[]

########################################
# Copilot / AI
########################################
COPILOT_ENABLED=false
COPILOT_STUDIO_URL=https://my-copilot-studio-endpoint.example.com
COPILOT_STUDIO_SECRET=my-super-secret-token

# Optional: Tuning
COPILOT_CACHE_TTL=3600
COPILOT_CONCURRENT_REQUESTS=5
COPILOT_TIMEOUT_SECONDS=30

########################################
# DocBee
########################################
DOCBEE_URL=https://docbee.example.com/api
DOCBEE_API_KEY=your-docbee-api-key

########################################
# MKS
########################################
MKS_URL=https://mks.example.com/api
MKS_USERNAME=your-mks-user
MKS_PASSWORD=your-mks-password

########################################
# N-Central
########################################
NCENTRAL_API_URL=https://ncentral.example.invalid
NCENTRAL_API_KEY=replace-me
NCENTRAL_TIMEOUT=30
NCENTRAL_MAX_CUSTOMER_PAGES=20

########################################
# Nist NVD
########################################
NVD_API_KEY=replace-me
NVD_MAX_CONCURRENT_REQUESTS=5

########################################
# SMTP / E-Mail-Ticketing
########################################
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
# STARTTLS validiert standardmäßig Zertifikatskette und SMTP_HOST.
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=30
SMTP_FROM_ADDRESS=vulnprocessing@example.invalid

########################################
# Ressourcenlimits (pro Prozess)
########################################
# MAX_REQUEST_BYTES enthält Multipart-Metadaten und muss mindestens 64 KiB
# größer als MAX_IMPORT_BYTES sein.
MAX_REQUEST_BYTES=11534336
MAX_IMPORT_BYTES=10485760
MAX_FINDINGS_PER_IMPORT=10000
MAX_FINDINGS_PER_TICKET_OPERATION=500
MAX_CVES_PER_FINDING=20
MAX_CVES_PER_TICKET_OPERATION=500
MAX_BATCH_CANDIDATES_PER_OPERATION=50
MAX_CONCURRENT_MANAGEMENT_OPERATIONS=4

########################################
# Feature Flags
########################################
ENABLE_WINDOWS_PATCH_FILTER=false

########################################
# JSON Path
########################################
LYWAND_JSON_PATH=./data/lywand/results.json
